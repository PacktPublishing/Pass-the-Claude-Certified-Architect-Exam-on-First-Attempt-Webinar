# Pick one way to sign in. Leave both lines blank to use your Claude subscription:
# run `claude` once and sign in, and the demo uses that login.
# On API billing, put a key from the Claude Console here instead.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Optional. A model alias or id for the demo agent; blank uses the Claude Code default.
# A small model is cheaper and fast enough on stage.
DEMO_MODEL=haiku
